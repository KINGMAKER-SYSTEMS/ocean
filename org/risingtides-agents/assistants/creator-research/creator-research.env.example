# creator-research — environment template.
# Copy to creator-research.env (gitignored) and fill in. NEVER commit the real file.

# --- Research engine (stays in place; reference, never fork) ----------------
# Where the engine lives on disk: HANDOFF.md (authoritative state), build
# scripts (build_sheet2.py, build_analytics.py, build_value_rank.py,
# ingest_views.py), views_scrape_workflow.js, handles.json, views_cache.json,
# rust/creator-research-readonly. Default matches the manifest
# (creator-research.toml [engine]).
OCEAN_CREATOR_RESEARCH_ENGINE_DIR=/Users/ericcromartie/Documents/Development/Creator Research Agent

# --- Perplexity API (rate benchmarks ONLY — never per-creator views) --------
# Resolved from 1Password at runtime (item read by ID — the title's em-dash
# breaks `op read` by name). Never echo the key.
PERPLEXITY_API_KEY=

# --- Ocean daemon (the brain) ------------------------------------------------
# Where a turn is reasoned (POST /v1/prompt). Default matches the daemon's bind.
OCEAN_DAEMON_URL=http://127.0.0.1:4780

# NOTE — Google Sheets access goes through the local `gws` CLI, which is
# keyring-authed on this machine; no Google credential belongs here. gws prints
# a "keyring" line to stderr — pipe JSON with 2>/dev/null.
