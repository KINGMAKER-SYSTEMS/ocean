# prompt-lab — environment template.
# Copy to prompt-lab.env (gitignored) and fill in. NEVER commit the real file.

# --- Lab engine (stays in place; reference, never fork) ---------------------
# Where the lab lives on disk: bakeoff.py, LAWS.md, RATCHET.md,
# MASTER-PROMPTS.md, MODULAR-PROMPTS.md + prompt_modules.json, state.json,
# anchors/, rounds/. Default matches the manifest (prompt-lab.toml [engine]).
OCEAN_PROMPT_LAB_ENGINE_DIR=/Users/ericcromartie/Documents/Development/prompting agent

# --- Content Lab API (the live backend the bake-off submits to and polls) ---
CONTENT_LAB_API_URL=https://risingtides-content-lab-production.up.railway.app
CONTENT_LAB_API_KEY=

# --- Ocean daemon (the brain) ------------------------------------------------
# Where a turn is reasoned (POST /v1/prompt). Default matches the daemon's bind.
OCEAN_DAEMON_URL=http://127.0.0.1:4780

# NOTE — engine-side credentials (GEMINI_API_KEY, OPENAI_API_KEY, FAL_KEY,
# REPLICATE_API_TOKEN) live in the ENGINE's own .env and are read by its scripts
# at runtime. They do NOT belong here, and that .env is never read into context.
