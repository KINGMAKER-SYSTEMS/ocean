# Copy to courier.env (gitignored) and adjust. The wrapper auto-loads it.
# No secrets belong here — the uiau binary resolves its own creds at runtime
# (APIFY_TOKEN / 1Password `op read`, the eric-claude-bot Slack env file,
# ANTHROPIC_API_KEY for the optional judge, `gws` CLI auth for Drive).

# Engine repo root (the path contains spaces — keep it quoted).
OCEAN_UIAU_ENGINE_DIR="/Users/ericcromartie/Documents/Development/Us In Another Universe Agent"

# Song factory the `status` verb lists (engine default; override if it moves).
# OCEAN_UIAU_AUDIO_DIR="/Users/ericcromartie/Documents/Development/Mon Hopecore Agent/factory/audio"
