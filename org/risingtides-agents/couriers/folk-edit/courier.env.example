# Copy to courier.env (gitignored) and fill in. The wrapper auto-loads it
# (shared couriers/courier.env first, then this package's courier.env).
#
# Where the standalone Mon Rovia folk edit agent engine checkout lives. The
# wrapper execs its factory/reel_pipeline.py and reads its state files for
# status. Only set this if the engine lives somewhere non-default.
# NOTE: the default path contains spaces — keep the value quoted.
#OCEAN_FOLK_EDIT_ENGINE_DIR="/Users/ericcromartie/Documents/Development/mon rovia folk edit agent"

# Python used to exec the pipeline. Must be the Content Posting Lab venv (has
# PIL, cv2, numpy, google-genai). Only set if the venv moved.
#OCEAN_FOLK_EDIT_PYTHON="/Users/ericcromartie/Projects/active/content-posting-lab/venv/bin/python"

# No tokens belong in this package. GEMINI_API_KEY, SLACK_BOT_TOKEN,
# SLACK_CHANNEL, and DRIVE_FOLDER_ID live in the engine's own .env
# (gitignored, perms 600, in the engine dir) — the pipeline loads it itself.
