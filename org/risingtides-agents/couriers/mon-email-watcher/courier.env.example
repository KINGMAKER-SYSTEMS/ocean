# Copy to courier.env (gitignored) and fill in. The wrapper auto-loads it —
# shared couriers/courier.env first, then this package-level file overrides.

# Where the mon-rovia-watcher engine lives (the repo holding
# target/release/mon-rovia-watcher, watcher_config.json, token.json, and
# .mon_watcher/ state). Default shown — only set to relocate the engine.
# OCEAN_MON_EMAIL_WATCHER_ENGINE_DIR=/Users/ericcromartie/Documents/Development/mon-rovia-email-watcher

# OPT-IN, engine-side: if set, a real `sweep` posts notifications straight to
# Slack instead of writing drafts to .mon_watcher/slack_drafts.jsonl. Leave
# unset for drafts-only (the default and this courier's stance — drafts never
# auto-send). Never put a real webhook URL in a committed file.
# MON_ROVIA_SLACK_WEBHOOK_URL=
