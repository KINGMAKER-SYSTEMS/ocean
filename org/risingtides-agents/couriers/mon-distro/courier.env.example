# Copy to courier.env (gitignored) and adjust. The wrapper auto-loads it.
# No secrets belong here — Postiz/Facebook creds live in the ENGINE repo's .env,
# which the mon-posting-agent binary loads itself from its own working dir.

# Engine repo root (the path contains a space — keep it quoted).
OCEAN_MON_DISTRO_ENGINE_DIR="/Users/ericcromartie/Documents/Development/Postiz Posting Agent"

# Live service base URL (launchd rust-serve; localhost needs no token).
OCEAN_MON_DISTRO_API_URL="http://127.0.0.1:3000"

# Hard latch: the wrapper refuses `post-now --enable-posting` unless this is 1.
# Leave unset. Flip only on explicit operator instruction, then unset again.
# OCEAN_MON_DISTRO_ALLOW_POSTING=1
