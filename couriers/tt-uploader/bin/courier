#!/bin/sh
# Ocean tt-uploader courier — read-first ops window into the TikTok auto-uploader
# engine (Playwright stealth + self-healing orchestrator, FastAPI backend).
# Usage:
#   courier health                  # GET /health on the backend API (liveness, no DB)
#   courier status                  # supervisor decision snapshot (logs/auto_supervisor.json)
#   courier heartbeat               # posted vs daily target per account (logs/heartbeat/codex-status.json)
#   courier escalations             # escalated blockers (logs/heartbeat/codex-escalation.json)
#   courier queue [--candidates]    # approved runnable manifest (or candidate manifest)
#   courier posts [--limit N]       # recent post-ledger entries (logs/post_log.json, default 10)
#   courier source                  # iCloud source readiness (logs/icloud_source_status.json)
#   courier dry-run                 # last dry-run state (logs/dry_run_status.json)
#   courier proxy                   # GET /api/system/proxy/status (read-only)
#   courier accounts                # GET /api/accounts
#   courier uploads                 # GET /api/uploads
#
# Read-only by design: v1 exposes NO upload trigger. Uploads stay entirely
# behind the engine's own orchestrator; this wrapper only reads status files
# and issues GETs. It never touches cookies, proxies, or stealth parameters.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PKG=$(CDPATH= cd -- "$HERE/.." && pwd)
COURIERS=$(CDPATH= cd -- "$PKG/.." && pwd)

# Local config (never committed): shared class-level env first, then the
# package-level file overrides it. Same convention as file-courier.
set -a
[ -f "$COURIERS/courier.env" ] && . "$COURIERS/courier.env"
[ -f "$PKG/courier.env" ] && . "$PKG/courier.env"
set +a

# The engine path contains spaces and parens — keep every expansion quoted.
ENGINE_DIR=${OCEAN_TT_UPLOADER_ENGINE_DIR:-"/Users/ericcromartie/Documents/Development/Auto Uploader (TT)"}
API_URL=${OCEAN_TT_UPLOADER_API_URL:-"http://127.0.0.1:8000"}
LOGS="$ENGINE_DIR/logs"

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

# Pretty-print a live status file the engine's orchestrator maintains under
# logs/ — read-only, the orchestrator owns all writes.
show() {
  if [ ! -f "$1" ]; then
    echo "status file not found: $1" >&2
    echo "is OCEAN_TT_UPLOADER_ENGINE_DIR right? engine=$ENGINE_DIR" >&2
    exit 1
  fi
  if command -v jq >/dev/null 2>&1; then jq . "$1"; else cat "$1"; fi
}

# GET a read-only backend route (FastAPI app.main:socket_app — local uvicorn
# on :8000 or Railway; localhost needs no token).
fetch() {
  if ! out=$(curl -sf --max-time 10 "$API_URL$1"); then
    echo "backend unreachable at $API_URL$1" >&2
    echo "it runs as: cd \"$ENGINE_DIR/backend\" && uvicorn app.main:socket_app --port 8000 (or on Railway — set OCEAN_TT_UPLOADER_API_URL)" >&2
    exit 1
  fi
  if command -v jq >/dev/null 2>&1; then printf '%s\n' "$out" | jq .; else printf '%s\n' "$out"; fi
}

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
  health)      fetch /health ;;
  proxy)       fetch /api/system/proxy/status ;;
  accounts)    fetch /api/accounts ;;
  uploads)     fetch /api/uploads ;;
  status)      show "$LOGS/auto_supervisor.json" ;;
  heartbeat)   show "$LOGS/heartbeat/codex-status.json" ;;
  escalations) show "$LOGS/heartbeat/codex-escalation.json" ;;
  source)      show "$LOGS/icloud_source_status.json" ;;
  dry-run)     show "$LOGS/dry_run_status.json" ;;
  queue)
    case "${1:-}" in
      --candidates) show "$LOGS/candidate_manifest.json" ;;
      *)            show "$LOGS/approved_manifest.json" ;;
    esac ;;
  posts)
    n=10
    if [ "${1:-}" = "--limit" ] && [ -n "${2:-}" ]; then n=$2; fi
    f="$LOGS/post_log.json"
    [ -f "$f" ] || { echo "status file not found: $f" >&2; exit 1; }
    if command -v jq >/dev/null 2>&1; then jq --argjson n "$n" '.[-$n:]' "$f"; else cat "$f"; fi ;;
  ""|-h|--help|help)
    usage ;;
  *)
    echo "unknown verb: $cmd (try: health|status|heartbeat|escalations|queue|posts|source|dry-run|proxy|accounts|uploads)" >&2
    exit 1 ;;
esac
