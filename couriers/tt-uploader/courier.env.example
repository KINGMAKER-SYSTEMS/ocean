# Copy to courier.env (gitignored) and adjust. The wrapper auto-loads it.
# No secrets belong here — proxy/Drive/Slack/Fernet creds live in the ENGINE
# repo's .env (PROXY_USERNAME/PROXY_PASSWORD, COOKIE_ENCRYPTION_KEY,
# GOOGLE_DRIVE_CREDENTIALS_PATH/GOOGLE_DRIVE_TOKEN_PATH, SLACK_WEBHOOK_URL, …),
# loaded by the engine itself. The courier never reads or relays them.

# Engine repo root (the path contains spaces AND parens — keep it quoted).
OCEAN_TT_UPLOADER_ENGINE_DIR="/Users/ericcromartie/Documents/Development/Auto Uploader (TT)"

# Backend API base URL (local uvicorn app.main:socket_app, or the Railway URL).
OCEAN_TT_UPLOADER_API_URL="http://127.0.0.1:8000"
