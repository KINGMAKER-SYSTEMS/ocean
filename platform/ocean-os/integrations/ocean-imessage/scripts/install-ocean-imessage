#!/bin/sh
set -eu

# Operator-run installer for the Ocean iMessage bridge.
#
# Builds the release binary, assembles a minimal background app bundle, and
# signs it with a STABLE code-signing identity. macOS ties Full Disk Access and
# Automation grants to an app's designated requirement. An ad-hoc signature's
# requirement is the binary hash, so every rebuild silently voids the grants and
# the reader stops seeing Messages; an identity-based signature keeps them
# across rebuilds. This script therefore refuses ad-hoc signing.
#
# Replacing the app bundle changes what a loaded LaunchAgent runs. The script
# refuses to do that implicitly: if the agent is loaded you must pass --load,
# which stops it, replaces the bundle, and starts it again. It never grants a
# permission and never writes the roster. A bridge started without a roster or
# without Full Disk Access idles and says so in its log; it does not crash-loop.

usage() {
    cat >&2 <<'USAGE'
usage: install-ocean-imessage --sign-identity "<identity name or SHA-1>"
           [--app-dir /ABSOLUTE/DIR]   default: ~/Applications
           [--bundle-id ID]            default: dev.risingtides.ocean-imessage
           [--load]                    stop, replace, and (re)start the LaunchAgent

List identities with: security find-identity -v -p codesigning
USAGE
    exit 2
}

fail() {
    echo "install-ocean-imessage: $1" >&2
    exit "${2:-1}"
}

IDENTITY=""
APP_DIR="$HOME/Applications"
BUNDLE_ID="dev.risingtides.ocean-imessage"
LOAD=0

while [ $# -gt 0 ]; do
    case "$1" in
        --sign-identity) [ $# -ge 2 ] || usage; IDENTITY=$2; shift 2 ;;
        --app-dir) [ $# -ge 2 ] || usage; APP_DIR=$2; shift 2 ;;
        --bundle-id) [ $# -ge 2 ] || usage; BUNDLE_ID=$2; shift 2 ;;
        --load) LOAD=1; shift ;;
        *) usage ;;
    esac
done

[ -n "$IDENTITY" ] || usage
[ "$IDENTITY" != "-" ] || fail "ad-hoc signing is refused; permission grants would not survive a rebuild" 2
case "$BUNDLE_ID" in
    *[!A-Za-z0-9.-]* | "") fail "invalid bundle id" 2 ;;
esac
# The path is written into a property list; keep it absolute and free of XML
# metacharacters and newlines.
case "$APP_DIR" in
    /*) ;;
    *) fail "--app-dir must be an absolute path" 2 ;;
esac
case "$APP_DIR" in
    *"<"* | *">"* | *"&"* | *'"'* | *"
"*) fail "--app-dir contains an unsupported character" 2 ;;
esac

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
APP="$APP_DIR/Ocean iMessage.app"
SUPPORT="$HOME/Library/Application Support/Ocean/iMessage"
PLIST="$HOME/Library/LaunchAgents/$BUNDLE_ID.plist"
DOMAIN="gui/$(id -u)"

agent_loaded() {
    launchctl print "$DOMAIN/$BUNDLE_ID" >/dev/null 2>&1
}

if agent_loaded && [ "$LOAD" -ne 1 ]; then
    fail "LaunchAgent $BUNDLE_ID is loaded and would start running the new build; pass --load to replace and restart it, or unload it first"
fi

swift build -c release --package-path "$ROOT"
BINARY="$ROOT/.build/release/ocean-imessage"
[ -x "$BINARY" ] || fail "release binary missing"

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
STAGED_APP="$STAGE/Ocean iMessage.app"
mkdir -p "$STAGED_APP/Contents/MacOS"
cp "$BINARY" "$STAGED_APP/Contents/MacOS/ocean-imessage"
cat > "$STAGED_APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>ocean-imessage</string>
  <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
  <key>CFBundleName</key><string>Ocean iMessage</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.2.0</string>
  <key>CFBundleVersion</key><string>2</string>
  <key>LSBackgroundOnly</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Ocean iMessage sends replies only to teammates enrolled on the operator's roster.</string>
</dict></plist>
PLIST

codesign --force --sign "$IDENTITY" --identifier "$BUNDLE_ID" "$STAGED_APP"
codesign --verify --strict "$STAGED_APP"
if codesign -dv "$STAGED_APP" 2>&1 | grep -q 'Signature=adhoc'; then
    fail "signature is ad-hoc; refusing to install"
fi

if agent_loaded; then
    launchctl bootout "$DOMAIN/$BUNDLE_ID" 2>/dev/null || true
    # bootout returns before the job is gone; a bootstrap that races it fails.
    tries=0
    while agent_loaded; do
        tries=$((tries + 1))
        [ "$tries" -le 40 ] || fail "LaunchAgent did not stop; nothing was replaced"
        sleep 0.25
    done
fi

mkdir -p "$APP_DIR" "$SUPPORT"
chmod 700 "$SUPPORT"
rm -rf "$APP"
mv "$STAGED_APP" "$APP"
echo "installed: $APP"
codesign -dr - "$APP" 2>&1 | sed -n 's/^designated => /designated requirement: /p'

if [ "$LOAD" -eq 1 ]; then
    mkdir -p "$HOME/Library/LaunchAgents"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$BUNDLE_ID</string>
  <key>ProgramArguments</key><array><string>$APP/Contents/MacOS/ocean-imessage</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$SUPPORT/service.out.log</string>
  <key>StandardErrorPath</key><string>$SUPPORT/service.err.log</string>
</dict></plist>
PLIST
    tries=0
    until launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null; do
        tries=$((tries + 1))
        [ "$tries" -le 8 ] || fail "LaunchAgent did not start; the app is installed but not running"
        sleep 0.5
    done
    echo "loaded: $DOMAIN/$BUNDLE_ID"
fi

cat <<NEXT

Next, by hand (this script cannot and does not do these):
  1. System Settings > Privacy & Security > Full Disk Access: enable "Ocean iMessage".
  2. Write the roster to "$SUPPORT/config.json" with mode 0600 (see README).
     The running bridge picks up roster edits on its own; no restart is needed.
  3. Watch "$SUPPORT/service.err.log". "roster loaded" and no
     "Messages database is unavailable" line means the app itself can read
     Messages. Running "check" from a terminal tests the terminal's permissions,
     not the app's, so it cannot answer that question.
  4. Approve the Messages Automation prompt the first time a reply is sent.
NEXT
