# yt-prompt-bible — environment template.
# Copy to yt-prompt-bible.env (gitignored) and fill in. NEVER commit the real file.

# --- Bible engine (stays in place; reference, never fork) --------------------
# Where the bible lives on disk: README.md (Style Registry), PROTOCOL.md,
# ENHANCE-PROTOCOL.md, TITLE/THUMBNAIL/RETENTION-PROTOCOL.md, _system/
# (11-section contract, anti-slop rules, pipeline generators), styles/<slug>/,
# workflows/, research/. Default matches the manifest (yt-prompt-bible.toml [engine]).
OCEAN_YT_PROMPT_BIBLE_ENGINE_DIR=/Users/ericcromartie/Documents/Development/yt-longform-prompt-bible

# --- Ocean daemon (the brain) ------------------------------------------------
# Where a turn is reasoned (POST /v1/prompt). Default matches the daemon's bind.
OCEAN_DAEMON_URL=http://127.0.0.1:4780

# NOTE — engine-side credentials (GEMINI_API_KEY for workflows/gemini-watch.sh
# motion truth, with a 1Password fallback) live in the ENGINE's own environment
# and are read by its scripts at runtime. They do NOT belong here, and the
# engine's .env is never read into context.
